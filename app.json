{
  "expo": {
    "name": "Receipt Vault",
    "slug": "receipt-vault",
    "scheme": "receiptvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.av1yan.receipt-vault"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Receipt Vault to use the camera to capture receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Receipt Vault to add receipt photos from your library."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-sharing"
    ]
  }
}
